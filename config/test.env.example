# Test environment configuration for test_env_host.
# Copy this file to config/test.env and set a value for every variable.
# Variables marked "automatic" can be filled by the configure script, which
# reads them from GCP.

# ID of the isolated GCP test project that all test resources are created in.
# It must be exactly fck-rkn-test; any other project is rejected so test code
# can never touch production resources.
GCP_PROJECT_ID=fck-rkn-test

# GCP zone in which the test VMs (eu-server, ru-server, test-client) are
# created, for example europe-north1-a. Its region also hosts the Cloud
# Router and Cloud NAT that give the VMs outbound Internet access.
GCP_ZONE=europe-north1-a

# Compute Engine machine type of the test VMs, for example e2-micro. It
# determines the VM cost and the CPU/memory available to the services.
GCP_MACHINE_TYPE=e2-micro

# GCP project that publishes the boot image family used for the test VMs.
# For Ubuntu images this is ubuntu-os-cloud.
GCP_IMAGE_PROJECT=ubuntu-os-cloud

# Image family within GCP_IMAGE_PROJECT used for the VM boot disks. The newest
# image of the family is used, for example ubuntu-2404-lts-amd64.
GCP_IMAGE_FAMILY=ubuntu-2404-lts-amd64

# Name of the existing VPC network the test VMs are attached to. The network
# itself is never created or modified by test_env_host.
GCP_NETWORK=default

# Name of the existing subnetwork (in the region of GCP_ZONE) used by the test
# VMs and by Cloud NAT. It must belong to GCP_NETWORK.
GCP_SUBNETWORK=default

# IPv4 range of GCP_SUBNETWORK in CIDR notation, for example 10.166.0.0/20.
# The firewall generator allows ICMP only from and to this range. Automatic:
# read from the subnetwork by the configure script.
GCP_SUBNET_CIDR=10.166.0.0/20

# Network tag put on the test VMs. The SSH firewall rule targets only VMs with
# this tag, so SSH access is not opened project-wide.
GCP_SSH_NETWORK_TAG=fck-rkn-test-eu-server-ssh

# Name of the GCP VPC firewall rule that allows SSH (TCP/22) to VMs carrying
# GCP_SSH_NETWORK_TAG. The guest firewalls also allow SSH; this rule is an
# additional boundary, not the only enforcement.
GCP_SSH_FIREWALL_RULE=fck-rkn-test-eu-server-ssh

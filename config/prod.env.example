# Production-only settings for the initial EU deployment stage.
# Run `prod-env-host configure` to generate config/prod.env interactively, or
# copy this file to config/prod.env and fill in the empty values.
# The EU stage must not require RU SSH access; RU peer information is
# included only because the EU guest firewall needs the approved peer address.

# ==============================================================================
# EU-SERVER SETTINGS
# ==============================================================================

# IPv4 or IPv6 address assigned to eu-server. The controller uses it for SSH,
# and the Outline agent binds its service to it. Obtain it from the production
# network/operator configuration; do not use a test VM address.
EU_SERVER_ADDRESS=

# SSH account name authorized on eu-server. The account must be permitted to
# run the deployment commands and approved sudo operations. Obtain it from
# the production access policy.
EU_SSH_USER=

# Absolute path on the controller to the protected SSH key matching
# EU_SSH_USER's authorized key on eu-server. Store key material in an approved
# secret source; never put the key itself in this file.
EU_SSH_KEY_PATH=

# TCP port of eu-server's SSH service, from 1 through 65535. Obtain it from
# the production SSH configuration; 22 is the standard default.
EU_SSH_PORT=22

# JSON array of one or more IPv4 or IPv6 DNS resolver addresses used by
# eu-server. Obtain these from the production provider/network configuration.
EU_DNS_ADDRESSES=

# IPv4 DHCP server address used by eu-server. Obtain it from the production
# provider/network configuration.
EU_DHCP_SERVER_ADDRESS=

# JSON array of one or more IPv4 or IPv6 NTP server addresses used by
# eu-server. Obtain these from the production provider/time-service policy.
EU_NTP_ADDRESSES=

# JSON array of IPv4/IPv6 CIDR networks that are local to eu-server. These
# networks scope the guest firewall's local ICMP/ICMPv6 allowances; obtain
# them from the production network configuration.
EU_LOCAL_NETWORKS=


# ==============================================================================
# RU-SERVER SETTINGS
# ==============================================================================
# RU-only values are optional for Phase 2A. Phase 2B requires these values.

# RU_SERVER_ADDRESS is the sole RU host address for SSH and server policy.
RU_SERVER_ADDRESS=

# RU SSH credentials and port, which may be different from the EU server.
# The EU_SSH_USER, EU_SSH_KEY_PATH, and EU_SSH_PORT above are for the EU server.
RU_SSH_USER=
# Absolute path on the controller to the RU SSH private key.
RU_SSH_KEY_PATH=
# TCP port of ru-server's SSH service (defaults to 22 if not specified).
RU_SSH_PORT=

# RU network service addresses and local networks, discovered over read-only
# SSH where possible or supplied by the production network operator.
# JSON array of one or more IPv4/IPv6 DNS resolver addresses used by ru-server.
RU_DNS_ADDRESSES=
# IPv4 or IPv6 DHCP service address used by ru-server's production network.
RU_DHCP_SERVER_ADDRESS=
# JSON array of one or more IPv4/IPv6 NTP server addresses used by ru-server.
RU_NTP_ADDRESSES=
# JSON array of strict IPv4/IPv6 CIDR networks local to ru-server.
RU_LOCAL_NETWORKS=

# Non-empty JSON array of strict CIDR ranges used for RU GitHub egress.
# Obtain this from GitHub; do not use test/GCP ranges.
RU_SERVER_TO_GITHUB_ADDRESSES=["140.82.112.0/20", "143.55.64.0/20", "185.199.108.0/22", "192.30.252.0/22", "2606:50c0::/32", "2a0a:a440::/29"]

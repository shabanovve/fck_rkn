# Configuration of the server agents (production and test controller).
# Copy this file to config/agents.env and replace every SET_TO_* value.

# IPv4 or IPv6 address of eu-server used by the controller for SSH and by the
# service configuration. It must be reachable from the controller and be the
# address other VMs use to reach eu-server.
EU_SERVER_ADDRESS=SET_TO_EU_SERVER_ADDRESS

# Address (IP or DNS name) the controller uses to open SSH sessions to
# ru-server.
RU_SERVER_HOST=SET_TO_RU_SERVER_ADDRESS

# Private (internal network) IP address of ru-server, used the same way as
# EU_SERVER_ADDRESS for EU peer rules.
RU_SERVER_PRIVATE_ADDRESS=SET_TO_RU_SERVER_PRIVATE_ADDRESS

# Address of the test-client VM that runs client-side checks. Optional: leave
# the placeholder or empty when no test-client is used (production).
TEST_CLIENT_HOST=SET_TO_TEST_CLIENT_ADDRESS

# User name used to log in to the servers over SSH. It needs permission to run
# the commands that deploy and test the services.
SSH_USER=SET_TO_SSH_USER

# Path to the private SSH key on the controller that matches an authorized key
# of SSH_USER on the servers. The key must never be committed to git.
SSH_KEY_PATH=SET_TO_PRIVATE_KEY_PATH

# TCP port of the SSH servers, from 1 to 65535. The default is 22.
SSH_PORT=22
